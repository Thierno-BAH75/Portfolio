# URL publique fixe du site (sans slash final), utilisée comme cible sûre
# par les routes serveur qui doivent s'auto-analyser (ex. l'outil d'analyse
# d'en-têtes de sécurité) — JAMAIS dérivée d'un en-tête de requête (Host,
# X-Forwarded-Host…), qui est falsifiable par l'appelant.
# Dev : http://localhost:3000 — Prod : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=

# Endpoint Formspree du formulaire de contact (https://formspree.io/f/VOTRE_ID)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Assistant IA — chaîne de bascule Gemini → Groq → Mistral (fetch natif,
# côté serveur uniquement, jamais exposées au client). Un fournisseur avec
# une clé absente est simplement ignoré, la chaîne continue avec le suivant.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Supabase — source de vérité du contenu (projets, expériences, compétences…)
# et authentification du panneau admin. NEXT_PUBLIC_* sont exposées au
# client (anon key, lecture publique via RLS) ; SUPABASE_SERVICE_ROLE_KEY
# reste strictement côté serveur (scripts de seed, futures routes admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
